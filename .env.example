# =============================================
# BF AUTO MARKET — Variables d'environnement
# =============================================
# Copie ce fichier en .env.local et remplis les valeurs

# 🔑 Clé API Anthropic (OBLIGATOIRE)
# Obtiens-la sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx

# 🗄️ Supabase (OBLIGATOIRE)
# Obtiens ces valeurs sur https://supabase.com → ton projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxx

# 🔐 Clé secrète pour le cron job (invente un mot de passe)
CRON_SECRET=ton-mot-de-passe-secret-ici

# 📧 Email pour les notifications (optionnel)
NOTIFICATION_EMAIL=tarpaga10@gmail.com
